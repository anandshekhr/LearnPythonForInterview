# ---- Required -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=change-me
POSTGRES_PASSWORD=change-me

# ---- Published ports (host side) ------------------------------------------
# UI + API through Nginx: http://localhost:${WEB_PORT}
WEB_PORT=8080
WEB_BIND=0.0.0.0
# Direct API access (Swagger at /api/docs/). Loopback only unless you change API_BIND.
API_PORT=8000
API_BIND=127.0.0.1
# Postgres/Redis are internal; publish them for local tools with docker-compose.dev.yml (DB_PORT / REDIS_PORT).

# ---- Django ----------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080
# Behind HTTPS in production:
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# ---- Database / cache ---------------------------------------------------------
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# ---- AI (optional; the platform works fully without it) -----------------------
# LLM_PROVIDER: none | anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# EMBEDDING_PROVIDER: hashing (local) | openai (OpenAI-compatible, must return 384 dims)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---- Job sources / automation -------------------------------------------------
SOURCE_HTTP_TIMEOUT_SECONDS=20
SOURCE_USER_AGENT=JobPilot/1.0 (personal job search assistant; contact: you@example.com)
JOB_EXPIRY_GRACE_DAYS=3
BROWSER_AUTOMATION_ENABLED=0
RESUME_MAX_UPLOAD_BYTES=5242880
ENCRYPT_FILES_AT_REST=1

# ---- Rate limits ----------------------------------------------------------------
THROTTLE_USER=2000/hour
THROTTLE_AUTH=20/minute
THROTTLE_SUBMIT=30/hour
